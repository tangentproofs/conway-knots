  obtain ⟨e1a, e1b⟩ := hr1
  obtain ⟨e2a, e2b⟩ := hr2
  obtain ⟨e3a, e3b⟩ := hr3
  have hmRw : Not ((col 8 = col 9) ∧ (col 9 = col 3)) := hm
  have hnum : col 9 - col 8 = col 2 - col 1 := by linarith
  have hden3 : col 9 - col 3 = -(3 * (col 2 - col 1)) := by linarith
  have hd : col 2 - col 1 ≠ 0 := by
